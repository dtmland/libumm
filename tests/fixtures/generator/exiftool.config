# User-defined tags for the Phase 1 unknown-tags fixture.
# Loaded with ExifTool's -config option (must be the first CLI option).

%Image::ExifTool::UserDefined = (
    'Image::ExifTool::XMP::Main' => {
        libummtest => {
            SubDirectory => {
                TagTable => 'Image::ExifTool::UserDefined::libummtest',
            },
        },
    },
    'Image::ExifTool::Exif::Main' => {
        0xFEDC => {
            Name => 'LibummUnknownExif',
            Writable => 'string',
        },
    },
);

%Image::ExifTool::UserDefined::libummtest = (
    GROUPS => { 0 => 'XMP', 1 => 'XMP-libummtest', 2 => 'Image' },
    NAMESPACE => { 'libummtest' => 'https://example.invalid/ns/libummtest/' },
    WRITABLE => 'string',
    UnknownWidget => { },
);

1;
