    },
    {
      "id": "png_description",
      "source": {
        "kind": "base_key",
        "key": "ExifTool.PNG.Description"
      },
      "target": {
        "kind": "property",
        "key": "iptc.photo.description"
      },
      "heuristic": "H7",
      "citation": "PNG Description to lang-alt x-default (H7)"
    },
    {
      "id": "png_copyright",
      "source": {
        "kind": "base_key",
        "key": "ExifTool.PNG.Copyright"
      },
      "target": {
        "kind": "property",
        "key": "iptc.photo.copyrightNotice"
      },
      "heuristic": "H7",
      "citation": "PNG Copyright to lang-alt x-default (H7)"
    },
    {
      "id": "png_description_comment",
      "source": {
        "kind": "base_key",
        "key": "Png.Text.Description"
      },
      "target": {
        "kind": "property",
        "key": "iptc.photo.description"
