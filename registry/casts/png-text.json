        "key": "ExifTool.PNG.Title"
      },
      "target": {
        "kind": "property",
        "key": "iptc.photo.title"
      },
      "heuristic": "H7",
      "citation": "PNG Title (tEXt or iTXt) to lang-alt x-default (H7)"
    },
    {
      "id": "png_author",
      "source": {
