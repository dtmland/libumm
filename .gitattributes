# Importer output is UTF-8 with LF newlines and compared byte-for-byte.
registry/**/*.json text eol=lf
src/generated/** text eol=lf
# Generated supported-types.md is compared byte-for-byte with the generator.
supported-types.md text eol=lf

# Fixture stills must stay binary so Windows checkouts do not alter bytes.
tests/fixtures/**/*.jpg binary
tests/fixtures/**/*.tif binary
tests/fixtures/**/*.png binary
tests/fixtures/**/*.webp binary
tests/fixtures/**/*.dng binary
# XMP sidecars are UTF-8 text; pin LF for byte-stable checkouts.
tests/fixtures/**/*.xmp text eol=lf
